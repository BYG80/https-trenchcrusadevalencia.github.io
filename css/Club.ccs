
/* =========================================================
   CLUB
   CSS ESPECÍFICO
   ========================================================= */


/* =========================================================
   HERO
   ========================================================= */

.club-hero {

    min-height: 600px;

    display: flex;

    justify-content: center;

    align-items: center;

    text-align: center;

    padding: 140px 20px 100px;

    background:
        linear-gradient(
            rgba(0,0,0,.72),
            rgba(0,0,0,.90)
        ),
        url("../assets/img/hero.jpg");

    background-size: cover;

    background-position: center;

}


.club-hero-content {

    max-width: 900px;

    width: 100%;

}


.club-status {

    display: inline-block;

    padding: 8px 18px;

    margin-bottom: 25px;

    border: 1px solid #7c1111;

    border-radius: 4px;

    color: #d9b96d;

    font-size: 13px;

    font-weight: 700;

    letter-spacing: 2px;

}


.club-hero h2 {

    font-family: Cinzel, serif;

    font-size: 75px;

    color: #d9b96d;

    margin-bottom: 15px;

}


.club-subtitle {

    font-family: Cinzel, serif;

    font-size: 25px;

    letter-spacing: 5px;

    color: #ffffff;

    margin-bottom: 30px;

}


.club-hero-text {

    max-width: 800px;

    margin: 0 auto 35px;

    color: #d1c7ac;

    font-size: 20px;

    line-height: 1.8;

}


/* =========================================================
   SECCIONES
   ========================================================= */

.club-section {

    padding: 100px 8%;

    background: #0d0d0d;

}


.club-dark {

    padding: 100px 8%;

    background: #090909;

}


.club-container {

    width: 100%;

    max-width: 1200px;

    margin: 0 auto;

}


.club-container > h2 {

    font-family: Cinzel, serif;

    font-size: 45px;

    color: #d9b96d;

    text-align: center;

    margin-bottom: 35px;

}


.club-intro {

    max-width: 900px;

    margin: 0 auto 25px;

    text-align: center;

    color: #c4c0b5;

    font-size: 18px;

    line-height: 1.8;

}


.section-intro {

    max-width: 750px;

    margin: -10px auto 55px;

    text-align: center;

    color: #bdb7a5;

    font-size: 18px;

    line-height: 1.7;

}


/* =========================================================
   DESTACADO
   ========================================================= */

.club-highlight {

    display: flex;

    align-items: center;

    gap: 30px;

    max-width: 900px;

    margin: 60px auto 0;

    padding: 35px;

    background: #181818;

    border-left: 4px solid #7c1111;

    border-radius: 8px;

}


.highlight-icon {

    font-size: 55px;

    color: #d9b96d;

    min-width: 70px;

    text-align: center;

}


.club-highlight h3 {

    font-family: Cinzel, serif;

    color: #d9b96d;

    font-size: 23px;

    margin-bottom: 12px;

}


.club-highlight p {

    color: #c4c0b5;

    line-height: 1.7;

}


/* =========================================================
   GRID PRINCIPAL
   ========================================================= */

.club-grid {

    display: grid;

    grid-template-columns:
        repeat(4, minmax(0, 1fr));

    gap: 25px;

}


.club-card {

    position: relative;

    background: #181818;

    border: 1px solid #2c2c2c;

    border-top: 3px solid #7c1111;

    border-radius: 10px;

    padding: 70px 25px 30px;

    min-height: 310px;

    text-align: center;

    transition: .3s;

}


.club-card:hover {

    transform: translateY(-8px);

    border-color: #7c1111;

    box-shadow:
        0 10px 30px rgba(0,0,0,.4);

}


/* =========================================================
   NÚMEROS
   ========================================================= */

.club-card-number {

    position: absolute;

    top: 15px;

    left: 0;

    right: 0;

    font-family: Cinzel, serif;

    font-size: 34px;

    font-weight: 700;

    color: #7c1111;

}


/* =========================================================
   TÍTULOS TARJETAS
   ========================================================= */

.club-card h3 {

    font-family: Cinzel, serif;

    color: #d9b96d;

    font-size: 21px;

    margin-bottom: 20px;

}


.club-card p {

    color: #c4c0b5;

    line-height: 1.7;

    font-size: 16px;

    margin-bottom: 25px;

}


/* =========================================================
   ESTADO
   ========================================================= */

.coming-soon {

    display: inline-block;

    padding: 6px 12px;

    border: 1px solid #3a3a3a;

    border-radius: 4px;

    color: #888;

    font-size: 11px;

    font-weight: 700;

    letter-spacing: 1.5px;

}


/* =========================================================
   QUIÉN PUEDE UNIRSE
   ========================================================= */

.join-grid {

    display: grid;

    grid-template-columns:
        repeat(3, minmax(0, 1fr));

    gap: 25px;

    max-width: 1050px;

    margin: 0 auto;

}


.join-grid article {

    padding: 30px;

    background: #181818;

    border: 1px solid #2c2c2c;

    border-radius: 10px;

    transition: .3s;

}


.join-grid article:hover {

    transform: translateY(-6px);

    border-color: #7c1111;

}


.join-number {

    font-family: Cinzel, serif;

    font-size: 25px;

    font-weight: 700;

    color: #7c1111;

    margin-bottom: 15px;

}


.join-grid h3 {

    font-family: Cinzel, serif;

    color: #d9b96d;

    font-size: 20px;

    margin-bottom: 15px;

}


.join-grid p {

    color: #c4c0b5;

    line-height: 1.7;

}


/* =========================================================
   PASOS
   ========================================================= */

.club-steps {

    display: grid;

    grid-template-columns:
        repeat(4, minmax(0, 1fr));

    gap: 25px;

}


.club-step {

    position: relative;

    padding: 35px 25px;

    text-align: center;

    border: 1px solid #2c2c2c;

    background: #181818;

    border-radius: 10px;

}


.club-step span {

    display: block;

    font-family: Cinzel, serif;

    font-size: 32px;

    font-weight: 700;

    color: #7c1111;

    margin-bottom: 20px;

}


.club-step h3 {

    font-family: Cinzel, serif;

    color: #d9b96d;

    font-size: 19px;

    margin-bottom: 15px;

}


.club-step p {

    color: #bdb7a5;

    line-height: 1.6;

    font-size: 15px;

}


/* =========================================================
   FINAL
   ========================================================= */

.club-final {

    min-height: 500px;

    display: flex;

    justify-content: center;

    align-items: center;

    text-align: center;

    padding: 100px 20px;

    background:
        linear-gradient(
            rgba(0,0,0,.75),
            rgba(0,0,0,.90)
        ),
        url("../assets/img/hero.jpg");

    background-size: cover;

    background-position: center;

}


.club-final-content {

    max-width: 850px;

}


.club-final h2 {

    font-family: Cinzel, serif;

    font-size: 50px;

    color: #d9b96d;

    margin-bottom: 25px;

}


.club-final p {

    max-width: 750px;

    margin: 0 auto 35px;

    color: #d1c7ac;

    font-size: 19px;

    line-height: 1.8;

}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 1000px) {


    .club-grid {

        grid-template-columns:
            repeat(2, minmax(0, 1fr));

    }


    .club-steps {

        grid-template-columns:
            repeat(2, minmax(0, 1fr));

    }


    .club-hero h2 {

        font-size: 60px;

    }


}


/* =========================================================
   MÓVIL
   ========================================================= */

@media (max-width: 700px) {


    .club-section,
    .club-dark {

        padding: 70px 20px;

    }


    .club-hero {

        min-height: 500px;

        padding: 160px 20px 80px;

    }


    .club-hero h2 {

        font-size: 45px;

    }


    .club-subtitle {

        font-size: 18px;

        letter-spacing: 3px;

    }


    .club-hero-text {

        font-size: 17px;

    }


    .club-container > h2 {

        font-size: 35px;

    }


    .club-intro {

        font-size: 16px;

    }


    .club-highlight {

        flex-direction: column;

        text-align: center;

        padding: 30px 20px;

    }


    .club-grid {

        grid-template-columns: 1fr;

    }


    .club-card {

        min-height: auto;

    }


    .join-grid {

        grid-template-columns: 1fr;

    }


    .club-steps {

        grid-template-columns: 1fr;

    }


    .club-final h2 {

        font-size: 38px;

    }


    .club-final p {

        font-size: 17px;

    }


}


/* =========================================================
   MÓVILES PEQUEÑOS
   ========================================================= */

@media (max-width: 450px) {


    .club-hero h2 {

        font-size: 38px;

    }


    .club-hero p {

        font-size: 16px;

    }


    .club-container > h2 {

        font-size: 30px;

    }


    .club-card h3 {

        font-size: 19px;

    }


    .club-final h2 {

        font-size: 32px;

    }


}

